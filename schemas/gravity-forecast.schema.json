{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aizp.dev/schemas/wire-2/gravity-forecast.schema.json",
  "title": "AIZP GRAVITY_FORECAST Event",
  "type": "object",
  "required": ["protocol", "protocol_version", "event", "event_id", "timestamp", "agent_id", "session_id", "payload"],
  "properties": {
    "_description":     { "type": "string" },
    "protocol":         { "type": "string", "const": "AIZP" },
    "protocol_version": { "type": "string", "const": "V0.6" },
    "wire_version":     { "type": "integer", "const": 2 },
    "event":            { "type": "string", "const": "GRAVITY_FORECAST" },
    "event_id":         { "type": "string", "format": "uuid" },
    "timestamp":        { "type": "string", "format": "date-time" },
    "agent_id":         { "type": "string", "minLength": 1 },
    "session_id":       { "type": "string", "minLength": 1 },
    "payload": {
      "type": "object",
      "required": ["current_state", "forecast_horizon_steps", "predicted_states", "predicted_violation_probability", "model"],
      "properties": {
        "current_state": {
          "type": "string",
          "enum": ["STABLE_ORBIT", "DRIFT_WARNING", "GRAVITY_LOCK_PENDING", "QUARANTINED", "RECENTERING", "SAFE_STOP"]
        },
        "forecast_horizon_steps": { "type": "integer", "minimum": 1, "maximum": 100 },
        "predicted_states": {
          "type": "object",
          "propertyNames": { "enum": ["STABLE_ORBIT", "DRIFT_WARNING", "GRAVITY_LOCK_PENDING", "QUARANTINED", "RECENTERING", "SAFE_STOP"] },
          "additionalProperties": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
        },
        "predicted_violation_probability": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "point_of_no_return_distance": {
          "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }]
        },
        "absorbing_state_expected_arrival_steps": { "type": "number", "minimum": 0.0 },
        "model": { "type": "string", "enum": ["DTMC", "ABSORBING_MC", "HMM"] },
        "model_version": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
